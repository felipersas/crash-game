{
  "name": "@crash/wallets",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "NODE_ENV=production bun run scripts/build.ts",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "start:prod": "NODE_ENV=production bun dist/main.js",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "DATABASE_URL='postgresql://admin:admin@localhost:5432/wallets' bun run prisma/seed.ts"
  },
  "dependencies": {
    "@crash/domain": "workspace:*",
    "@crash/messaging": "workspace:*",
    "@crash/observability": "workspace:*",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^1.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jwks-rsa": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@crash/eslint-config": "workspace:*",
    "@crash/prettier-config": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/rabbitmq": "^11.14.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.1",
    "@types/passport-jwt": "^4.0.1",
    "bun-types": "^1.3.13",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "testcontainers": "^11.14.0",
    "typescript": "^5.8.3"
  }
}
