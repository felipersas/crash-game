{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "types": ["bun-types"],
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/domain": ["./src/domain"],
      "@/domain/entities": ["./src/domain/entities"],
      "@/domain/value-objects": ["./src/domain/value-objects"],
      "@/domain/events": ["./src/domain/events"],
      "@/domain/errors": ["./src/domain/errors"],
      "@/application": ["./src/application"],
      "@/application/use-cases": ["./src/application/use-cases"],
      "@/application/interfaces": ["./src/application/interfaces"],
      "@/infrastructure": ["./src/infrastructure"],
      "@/infrastructure/persistence": ["./src/infrastructure/persistence"],
      "@/infrastructure/messaging": ["./src/infrastructure/messaging"],
      "@/infrastructure/di": ["./src/infrastructure/di"],
      "@/presentation": ["./src/presentation"],
      "@/presentation/controllers": ["./src/presentation/controllers"],
      "@/presentation/dtos": ["./src/presentation/dtos"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
