{
  "name": "@crash/games",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "NODE_ENV=production bun run scripts/build.ts",
    "test": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "test:find-seeds": "bun run tests/helpers/find-deterministic-seeds.ts",
    "start:prod": "NODE_ENV=production bun dist/main.js",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@crash/domain": "workspace:*",
    "@crash/messaging": "workspace:*",
    "@crash/observability": "workspace:*",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/client": "^6.3.0",
    "amqp-connection-manager": "^4.1.2",
    "ioredis": "^5.6.1",
    "amqplib": "^0.10.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jwks-rsa": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.6.0"
  },
  "devDependencies": {
    "@crash/eslint-config": "workspace:*",
    "@crash/prettier-config": "workspace:*",
    "@nestjs/testing": "^11.1.17",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/rabbitmq": "^11.14.0",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.6",
    "@types/passport-jwt": "^4.0.1",
    "bun-types": "latest",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "prisma": "^6.3.0",
    "testcontainers": "^11.14.0",
    "typescript": "^5.8.3"
  }
}
