// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Round {
  id               String    @id @default(uuid())
  seed             String
  seedHash         String
  nextSeed         String?   @map("next_seed")
  status           RoundStatus
  crashPoint       Float?    @map("crash_point")
  bettingEndTime   DateTime? @map("betting_end_time")
  startedAt        DateTime? @map("started_at")
  crashedAt        DateTime? @map("crashed_at")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  bets             Bet[]

  @@map("rounds")
}

model Bet {
  id                String       @id @default(uuid())
  roundId           String       @map("round_id")
  playerId          String       @map("player_id")
  amountCents       BigInt       @map("amount_cents")
  status            BetStatus
  cashOutMultiplier Float?       @map("cash_out_multiplier")
  cashOutAmount     BigInt?      @map("cash_out_amount")
  cashedOutAt       DateTime?    @map("cashed_out_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  round             Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([playerId])
  @@map("bets")
}

model OutboxEvent {
  id           String             @id @default(uuid())
  aggregateId  String             @map("aggregate_id")
  eventType    String             @map("event_type")
  payload      Json
  status       OutboxEventStatus  @default(PENDING)
  retryCount   Int?               @default(0) @map("retry_count")
  sentAt       DateTime?          @map("sent_at")
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([aggregateId, status])
  @@index([status, createdAt])
  @@map("outbox_events")
}

enum RoundStatus {
  BETTING
  ACTIVE
  CRASHED
}

enum BetStatus {
  ACTIVE
  CASHED_OUT
  LOST
}

enum OutboxEventStatus {
  PENDING
  SENT
  FAILED
}
