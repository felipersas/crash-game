  "panels": [
    {
      "title": "RabbitMQ Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "RabbitMQ Message Rate",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops/s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_delivered_total[5m]))",
          "legendFormat": "delivered {{queue}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "sum by (queue) (rate(rabbitmq_queue_messages_published_total[5m]))",
          "legendFormat": "published {{queue}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "RabbitMQ Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": {} },
