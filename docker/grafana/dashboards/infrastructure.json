        {
          "expr": "rabbitmq_connections",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "RabbitMQ Consumers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers)",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    }
