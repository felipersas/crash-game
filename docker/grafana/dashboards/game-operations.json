{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "RTP (Return to Player)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "crash_game_rtp_percentage",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "RTP Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "expr": "crash_game_rtp_percentage",
          "legendFormat": "RTP",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Bet Volume (rate/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops/min",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(crash_game_bets_total[5m]) * 60)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Active Players",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        {
          "expr": "crash_game_active_players",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Crash Point Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 9, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        {
          "expr": "sum by (le) (rate(crash_game_round_crash_point_bucket[5m]))",
          "legendFormat": "{{le}}x",
          "format": "heatmap",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Payout Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 9, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "currency/min",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "rate(crash_game_payout_cents_total[5m]) * 60",
          "legendFormat": "payouts/min (cents)",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Bet Amount Distribution",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": {} },
      "targets": [
        {
          "expr": "sum by (le) (rate(crash_game_bet_amount_cents_bucket[5m]))",
          "legendFormat": "{{le}} cents",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },
    {
      "title": "Round Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(crash_game_round_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(crash_game_round_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    }
  ],
  "schemaVersion": 40,
  "tags": ["game", "operations"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Game Operations",
  "uid": "game-operations"
}
